{
  "name": "@devansharora18/tardis-ts",
  "version": "2.0.0-alpha.0",
  "description": "TSX-native UI framework for desktop and web with a Rust renderer.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "tardis-ts": "./dist/bin/tardis-ts.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./scene": {
      "types": "./dist/src/scene/index.d.ts",
      "import": "./dist/scene/index.mjs"
    },
    "./compiler": {
      "types": "./dist/src/compiler/index.d.ts",
      "import": "./dist/compiler/index.mjs"
    },
    "./web": {
      "types": "./dist/src/web/index.d.ts",
      "import": "./dist/web/index.mjs"
    },
    "./ssr": {
      "types": "./dist/src/ssr/index.d.ts",
      "import": "./dist/ssr/index.mjs"
    },
    "./devtools": {
      "types": "./dist/src/devtools/index.d.ts",
      "import": "./dist/devtools/index.mjs"
    }
  },
  "files": [
    "dist",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/crates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:lib": "rollup -c",
    "build:bin": "rollup -c rollup.cli.config.js && node -e \"if(process.platform!=='win32')require('node:fs').chmodSync('dist/bin/tardis-ts.js',0o755)\"",
    "build:native": "cargo build --manifest-path native/Cargo.toml --release",
    "build": "npm run clean && npm run build:lib && npm run build:bin",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "publish:check": "npm run build && npm run typecheck && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run publish:check",
    "bench:web": "node bench/web-frame/run.mjs",
    "bench:sheet": "node bench/sheet-frame/run.mjs"
  },
  "keywords": [
    "tsx",
    "native",
    "framework",
    "signals",
    "no-vdom",
    "rust",
    "gui",
    "desktop"
  ],
  "author": "devansharora18",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.0.0",
    "commander": "^12.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "rollup": "^4.0.0",
    "tslib": "^2.0.0",
    "vitest": "^1.0.0"
  }
}
