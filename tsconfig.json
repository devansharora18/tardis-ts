{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "tardisjs/scene": ["./src/scene/index.ts"],
      "@devansharora18/tardisjs/scene": ["./src/scene/index.ts"],
      "@devansharora18/tardisjs/web": ["./src/web/index.ts"],
      "@devansharora18/tardisjs/ssr": ["./src/ssr/index.ts"],
      "tardisjs/compiler": ["./src/compiler/index.ts"],
      "tardisjs/web": ["./src/web/index.ts"],
      "tardisjs/ssr": ["./src/ssr/index.ts"],
      "@devansharora18/tardisjs/compiler": ["./src/compiler/index.ts"]
    }
  },
  "include": ["src/**/*", "bin/**/*"],
  "exclude": ["node_modules", "dist", "test", "vscode-extension", "native", "examples", "tardisjs-site"]
}
